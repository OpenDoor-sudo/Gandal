# Copy to .env and fill in your keys:
#   cp .env.example .env

# Required for Gemini Live voice (Gandho hears you)
GOOGLE_API_KEY=your_google_api_key_here

# Desktop online testing (recommended until Ventuno Q arrives)
ONLINE_MODE=1
OFFLINE_MODE=0

# LiveKit — local dev server or LiveKit Cloud
# Use 127.0.0.1 (not localhost) so Linux does not hang on IPv6 ::1.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecretsecret

# Keep desktop startup within LiveKit's process limits. Set idle processes to
# 1+ only on a machine with enough CPU/RAM to prewarm multiple agent copies.
LIVEKIT_NUM_IDLE_PROCESSES=0
LIVEKIT_INITIALIZE_PROCESS_TIMEOUT=60

# Optional: LiveKit Cloud override when ONLINE_MODE=1
# LIVEKIT_CLOUD_URL=wss://YOUR_PROJECT.livekit.cloud

# Ventuno Q appliance (later — local-first)
# OFFLINE_MODE=1
# ONLINE_MODE=0
# Same OpenAI-compatible Gemma the rest of Gandal uses (Space / voice / graphs).
# Use 127.0.0.1 so Linux does not hang on IPv6 localhost.
# LOCAL_LLM_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_MODEL=gemma-4-e4b
# KOKORO_TTS_URL=http://localhost:8880/v1
