# Copy to .env (never commit secrets). Arduino Ventuno Q is the production board.

HARDWARE_TARGET=ventuno

# LiveKit — same URL/keys for display_client.py and python livekit_stack/agent/run_agent.py
# Online testing: set your LiveKit Cloud URL (wss://<project>.livekit.cloud), not localhost.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecretsecret
# Optional: named worker. Leave empty so the default tutor_agent.py worker is dispatched.
# LIVEKIT_AGENT_NAME=
# VOICE_ENGINE=gemini   # force Gemini Flash Live (skip Gemma) while testing online

# Gemini Flash Live (used when the student is online, or Gemma cannot answer)
# Model: gemini-3.1-flash-live-preview
GOOGLE_API_KEY=

# On-device Gemma 4 E4B (native audio sidecar or in-process HF weights)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=gemma-4-e4b
GEMMA_AUDIO_URL=
GEMMA_LOAD_LOCAL=0
KOKORO_URL=http://localhost:8880/v1

# Spatius 3D avatar — free Studio account is enough for public avatars
# https://app.spatius.ai/  → Apps (App ID + API Key) and Avatar Library (copy public avatar-id)
# Playground (no account): https://playground.spatius.ai/
SPATIUS_API_KEY=
SPATIUS_APP_ID=
SPATIUS_AVATAR_ID=
SPATIUS_REGION=us-west
